<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Android 12+ draws its own splash on top of our starting window.

      That splash shows the active launcher icon, which the system reads through
      PackageManager and masks itself - so it is the right icon for whichever
      activity-alias the user picked, and it is correctly shaped. Supplying an
      icon here would override all of that with one static drawable, so no icon
      item is given and the system's own behaviour is left alone.

      The reveal animation is still off: the brand colour is not the launcher
      icon's background, and the default zoom-out adds a beat between the splash
      and the first real frame of the app.
    -->
    <style name="Theme.LunarTune" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/window_starting</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

</resources>
